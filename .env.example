APP_NAME=NearFix API
ENVIRONMENT=local
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

SECRET_KEY=change-this-secret-before-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_PORT_PUBLIC=3307
MYSQL_USER=nearfix_user
MYSQL_PASSWORD=nearfix_password
MYSQL_DATABASE=nearfix
MYSQL_ROOT_PASSWORD=nearfix_root_password
UPLOAD_DIR=uploads
